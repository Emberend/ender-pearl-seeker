{
	"schemaVersion": 1,
	"id": "eyelocator",
	"version": "${version}",
	"name": "末影寻珠",
	"description": "用末影之眼自动三角定位末地要塞：记录每次投掷的方位角，实时显示要塞坐标、距离与路标。完全客户端运行，联机也可用。",
	"authors": [
		"Emberend"
	],
	"contact": {
		"homepage": "https://github.com/Emberend/ender-pearl-seeker",
		"sources": "https://github.com/Emberend/ender-pearl-seeker",
		"issues": "https://github.com/Emberend/ender-pearl-seeker/issues"
	},
	"license": "MIT",
	"icon": "assets/eyelocator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.eyelocator.client.EyeLocatorClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=1.21.1 <1.21.9",
		"java": ">=21",
		"fabric-api": "*"
	}
}
